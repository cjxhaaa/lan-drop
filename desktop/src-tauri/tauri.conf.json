{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "文件互传",
  "version": "1.3.0",
  "identifier": "com.cjxh.filetransfer.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "文件互传",
        "width": 1040,
        "height": 680,
        "minWidth": 760,
        "minHeight": 500,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
